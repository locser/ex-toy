[mysqld]
# ===== BUFFER POOL - Quan trọng nhất =====
# Bộ nhớ đệm chính của InnoDB, nên set 70-80% RAM
innodb_buffer_pool_size = 512M
# Chia buffer pool thành nhiều instance để giảm lock contention
innodb_buffer_pool_instances = 4

# ===== TRANSACTION LOGS - Tối ưu cho write performance =====
# Kích thước log file lớn hơn để giảm checkpoint frequency
innodb_log_file_size = 128M
# Buffer trong memory trước khi ghi xuống disk
innodb_log_buffer_size = 32M
# 2 = chỉ flush log mỗi giây thay vì mỗi transaction (nhanh hơn nhưng có risk mất data)
# 1 = an toàn nhất nhưng chậm, 0 = nhanh nhất nhưng rủi ro cao
innodb_flush_log_at_trx_commit = 2

# ===== WRITE OPTIMIZATION =====
# Tắt doublewrite buffer để tăng tốc write (chỉ dùng khi có SSD/NVMe)
innodb_doublewrite = 0
# Tắt binary log nếu không cần replication
skip-log-bin
# Giảm sync binlog frequency
sync_binlog = 0

# ===== CONNECTION HANDLING =====
# Số connection tối đa (phù hợp với HikariCP pool size)
max_connections = 200
# Tăng limit lỗi connection
max_connect_errors = 100000
# Timeout cho connection idle
wait_timeout = 28800

# ===== QUERY CACHE - TẮT cho write-heavy workload =====
# Tắt query cache vì nó làm chậm write operations
query_cache_type = 0
query_cache_size = 0

# ===== IO THREADS - Tăng performance IO =====
# Số thread đọc (default 4)
innodb_read_io_threads = 6
# Số thread ghi (default 4) - quan trọng cho write-heavy
innodb_write_io_threads = 8
# Khả năng IO operations per second
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000

# ===== CONCURRENCY CONTROL =====
# 0 = MySQL tự động điều chỉnh thread concurrency
innodb_thread_concurrency = 0
# Bật adaptive hash index để tăng tốc truy vấn
innodb_adaptive_hash_index = ON
# Giảm thời gian chờ lock
innodb_lock_wait_timeout = 5

# ===== TABLE DEFINITIONS =====
# Engine mặc định
default-storage-engine = InnoDB
# Charset mặc định
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ===== TEMP TABLES - Cho bulk operations =====
# Kích thước tối đa temp table trong memory
tmp_table_size = 64M
max_heap_table_size = 64M

# ===== SPECIFIC CHO GIVEAWAY USE CASE =====
# Tắt performance schema để tiết kiệm memory
performance_schema = OFF
# Giảm table cache nếu ít table
table_open_cache = 400
# Tối ưu cho small data writes
innodb_page_size = 16K

[mysql]
# Client charset
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4